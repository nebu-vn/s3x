<Window x:Class="S3Explorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:S3Explorer.Services"
        Title="S3 Explorer" Icon="pack://application:,,,/Assets/app.ico" Width="1200" Height="720" MinWidth="820" MinHeight="460"
        Background="White" FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" KeyDown="Window_KeyDown">
    <Window.Resources>
        <svc:GroupExpandedConverter x:Key="GroupExpanded" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,14,10,10">
                <TextBlock DockPanel.Dock="Top" Text="S3 CONNECTIONS" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TertiaryBrush}" Margin="8,0,0,8" />

                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolButton}" Content="&#xE710;" ToolTip="Add connection" Click="AddProfile_Click" />
                        <Button x:Name="EditButton" Style="{StaticResource ToolButton}" Content="&#xE70F;" Margin="2,0,0,0" ToolTip="Edit connection" Click="EditProfile_Click" />
                        <Button x:Name="DeleteButton" Style="{StaticResource ToolButton}" Content="&#xE738;" Margin="2,0,0,0" ToolTip="Delete connection" Click="DeleteProfile_Click" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource SidebarItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <!-- Grouped by provider domain; click a header to collapse / expand (remembered) -->
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel>
                                                    <ToggleButton x:Name="Toggle" Margin="0,6,0,1" Cursor="Hand" Focusable="False"
                                                                  Tag="{Binding Name}" ToolTip="{Binding Name}"
                                                                  IsChecked="{Binding Name, Mode=OneTime, Converter={StaticResource GroupExpanded}}"
                                                                  Checked="Group_Toggled" Unchecked="Group_Toggled">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,4,8,4">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#E8E8EC" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                        <DockPanel>
                                                            <TextBlock x:Name="Chevron" DockPanel.Dock="Left" Text="&#xE70D;" Width="14"
                                                                       FontFamily="{StaticResource IconFont}" FontSize="9"
                                                                       Foreground="{StaticResource TertiaryBrush}" VerticalAlignment="Center" />
                                                            <TextBlock DockPanel.Dock="Left" Text="&#xE968;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                       Foreground="{StaticResource TertiaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" FontSize="11"
                                                                       Foreground="{StaticResource TertiaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </ToggleButton>
                                                    <ItemsPresenter x:Name="Items" />
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger SourceName="Toggle" Property="IsChecked" Value="False">
                                                        <Setter TargetName="Items" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Display}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{x:Static svc:MacIcons.Cloud}" Width="30" Height="30" Margin="0,0,9,0" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Summary}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="#3A3A3C" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Summary}" Value="Not scanned">
                                                            <Setter Property="FontWeight" Value="Normal" />
                                                            <Setter Property="Foreground" Value="#8E8E93" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ScanTime}" FontSize="11" Foreground="{StaticResource TertiaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" Margin="-2,0" HorizontalAlignment="Center" Background="Transparent" />

        <!-- ===================== Content ===================== -->
        <DockPanel Grid.Column="2">
            <!-- Toolbar -->
            <Border DockPanel.Dock="Top" Padding="10,10,12,10" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource ToolButton}" Content="&#xE76B;" FontSize="12"
                            ToolTip="Back (Alt+←)" Click="Back_Click" />
                    <Button x:Name="UpButton" Grid.Column="1" Style="{StaticResource ToolButton}" Content="&#xE70E;" FontSize="12" Margin="2,0,10,0"
                            ToolTip="Up to parent folder (Backspace)" Click="Up_Click" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="FolderTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBox x:Name="PathBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                 MinHeight="0" FontSize="11.5" Foreground="{StaticResource TertiaryBrush}">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </StackPanel>

                    <!-- Search box -->
                    <Grid Grid.Column="3">
                        <TextBox x:Name="FilterBox" Padding="26,4,8,4" Background="#F2F2F5" BorderBrush="#E3E3E8"
                                 TextChanged="FilterBox_TextChanged" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{StaticResource TertiaryBrush}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Text="Search by name" Foreground="{StaticResource TertiaryBrush}" Margin="28,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button x:Name="DownloadFileButton" Grid.Column="4" Style="{StaticResource ToolButton}" Content="&#xE896;"
                            Margin="8,0,0,0" ToolTip="Download to Downloads folder (double-click file)" Click="Download_Click" />
                    <Button x:Name="DeleteFileButton" Grid.Column="5" Style="{StaticResource ToolButton}" Content="&#xE74D;"
                            Margin="2,0,0,0" ToolTip="Delete from S3 (Delete)" Click="DeleteItems_Click" />
                    <Button x:Name="RescanButton" Grid.Column="6" Margin="8,0,0,0" Click="Rescan_Click"
                            ToolTip="Reload metadata listing from S3 and update the cache (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Rescan" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelScanButton" Grid.Column="7" Content="Cancel" Margin="6,0,0,0" Visibility="Collapsed" Click="CancelScan_Click" />
                </Grid>
            </Border>

            <!-- Scan progress -->
            <Border x:Name="ProgressPanel" DockPanel.Dock="Top" Background="#F2F7FF" Padding="12,7"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                <DockPanel>
                    <ProgressBar IsIndeterminate="True" Width="120" Height="4" DockPanel.Dock="Left" VerticalAlignment="Center"
                                 Foreground="{StaticResource AccentBrush}" Background="#DCE6F5" BorderThickness="0" />
                    <TextBlock x:Name="ProgressText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryBrush}" />
                </DockPanel>
            </Border>

            <!-- Notice after download / delete -->
            <Border x:Name="NoticePanel" DockPanel.Dock="Top" Padding="12,6" Background="#EFF8F1"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="&#xE711;" FontSize="10"
                            MinHeight="22" MinWidth="24" Padding="4,2" ToolTip="Close" Click="CloseNotice_Click" />
                    <Button x:Name="NoticeOpenButton" DockPanel.Dock="Right" Content="Show in folder" MinHeight="24"
                            Padding="10,2" Margin="8,0,6,0" Click="NoticeOpen_Click" />
                    <TextBlock x:Name="NoticeText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" Background="#FAFAFB" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,5">
                <DockPanel>
                    <TextBlock x:Name="CacheStatus" DockPanel.Dock="Right" Foreground="{StaticResource TertiaryBrush}" FontSize="11.5" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="FolderStatus" Foreground="{StaticResource SecondaryBrush}" FontSize="11.5" />
                        <TextBlock x:Name="SelectionStatus" Foreground="{StaticResource AccentBrush}" FontSize="11.5" Margin="14,0,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Path bar (click to jump to a folder) -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,3">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="PathBar">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                               Foreground="{StaticResource TertiaryBrush}" VerticalAlignment="Center" Margin="3,0"
                                               Visibility="{Binding ChevronVisibility}" />
                                    <Button Style="{StaticResource ToolButton}" FontFamily="{StaticResource UiFont}" FontSize="12"
                                            Padding="5,2" MinHeight="22" MinWidth="0" Tag="{Binding Path}" Click="PathSegment_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="15" Height="15" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- File list -->
            <Grid>
                <ListView x:Name="FileList" BorderThickness="0" Background="White" Padding="6,0"
                          AlternationCount="2" ItemContainerStyle="{StaticResource FileRow}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          MouseDoubleClick="FileList_MouseDoubleClick"
                          KeyDown="FileList_KeyDown"
                          SelectionChanged="FileList_SelectionChanged">
                    <ListView.ContextMenu>
                        <ContextMenu Opened="FileMenu_Opened">
                            <MenuItem x:Name="OpenFolderMenu" Header="Open folder" Click="OpenFolder_Click" />
                            <MenuItem x:Name="OpenLocalMenu" Header="Open downloaded file" Click="OpenLocal_Click" />
                            <MenuItem x:Name="RevealLocalMenu" Header="Show downloaded file in folder" Click="RevealLocal_Click" />
                            <MenuItem Header="Download to Downloads" Click="Download_Click" />
                            <MenuItem Header="Download to another folder…" Click="DownloadTo_Click" />
                            <Separator />
                            <MenuItem Header="Copy to another bucket…" Click="CopyTo_Click" />
                            <MenuItem Header="Move to another bucket…" Click="MoveTo_Click" />
                            <Separator />
                            <MenuItem Header="Copy name" Click="CopyName_Click" />
                            <MenuItem Header="Copy key" Click="CopyKey_Click" />
                            <MenuItem Header="Copy s3:// path" Click="CopyUri_Click" />
                            <Separator />
                            <MenuItem Header="Delete from S3…" Click="DeleteItems_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="380">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Name" Tag="Name" Click="Header_Click" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding DownloadTip}">
                                            <Grid Width="20" Height="20" Margin="0,0,8,0">
                                                <Image Source="{Binding Icon}" />
                                                <!-- "Downloaded locally" badge -->
                                                <Border x:Name="DownloadedBadge" Visibility="Collapsed" Width="12" Height="12" CornerRadius="6"
                                                        Background="#34C759" BorderBrush="White" BorderThickness="1"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-2">
                                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="7" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="NameText" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                <Setter TargetName="DownloadedBadge" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDownloaded}" Value="True" />
                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="NameText" Property="Foreground" Value="#1E8E3E" />
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="140">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Date modified" Tag="Modified" Click="Header_Click" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModifiedText}" Opacity="0.62" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="100">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Size" Tag="Size" Click="Header_Click" HorizontalContentAlignment="Right" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" TextAlignment="Right" Opacity="0.62" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="80">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Files" Tag="Count" Click="Header_Click" HorizontalContentAlignment="Right" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CountText}" TextAlignment="Right" Opacity="0.62" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="160">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Type" Tag="Type" Click="Header_Click" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TypeName}" Opacity="0.62" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="110">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Storage class" Tag="Storage" Click="Header_Click" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StorageClass}" Opacity="0.62" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="40">
                    <Image Source="{x:Static svc:MacIcons.Folder}" Width="76" Height="76" Opacity="0.45" />
                    <TextBlock x:Name="EmptyText" Foreground="{StaticResource TertiaryBrush}" FontSize="14"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
