<Window x:Class="S3Explorer.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình S3" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="White" FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextBrush}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="#3A3A3C" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="2,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="22,20,22,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Tên hiển thị" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" />

        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Endpoint" VerticalAlignment="Top" Margin="0,6,12,0" />
        <StackPanel Grid.Row="2" Grid.Column="1">
            <TextBox x:Name="EndpointBox" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Để trống nếu dùng AWS S3. Với MinIO / Wasabi / Cloudflare R2 / DigitalOcean… nhập URL, ví dụ https://s3.example.com" />
        </StackPanel>

        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Region" />
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="RegionBox" />

        <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Bucket *" />
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="BucketBox" />

        <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="Thư mục (prefix)" VerticalAlignment="Top" Margin="0,6,12,0" />
        <StackPanel Grid.Row="8" Grid.Column="1">
            <TextBox x:Name="PrefixBox" />
            <TextBlock Style="{StaticResource Hint}" Text="Ví dụ: images/2026/ — để trống để xem toàn bộ bucket." />
        </StackPanel>

        <CheckBox Grid.Row="10" Grid.Column="1" x:Name="PathStyleBox"
                  Content="Force path-style (thường cần bật cho MinIO)" />

        <TextBlock Grid.Row="12" Style="{StaticResource Label}" Text="Access key" />
        <TextBox Grid.Row="12" Grid.Column="1" x:Name="AccessKeyBox" />

        <TextBlock Grid.Row="14" Style="{StaticResource Label}" Text="Secret key" VerticalAlignment="Top" Margin="0,6,12,0" />
        <StackPanel Grid.Row="14" Grid.Column="1">
            <PasswordBox x:Name="SecretBox" />
            <TextBlock x:Name="SecretHint" Style="{StaticResource Hint}"
                       Text="Được mã hóa bằng Windows DPAPI theo tài khoản Windows của bạn." />
        </StackPanel>

        <DockPanel Grid.Row="16" Grid.ColumnSpan="2" LastChildFill="False">
            <Button x:Name="TestButton" DockPanel.Dock="Left" Content="Kiểm tra kết nối" Click="Test_Click" />
            <TextBlock x:Name="TestResult" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                       MaxWidth="200" TextTrimming="CharacterEllipsis" />
            <Button DockPanel.Dock="Right" Content="Hủy" IsCancel="True" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Lưu" IsDefault="True" MinWidth="80" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </DockPanel>
    </Grid>
</Window>
